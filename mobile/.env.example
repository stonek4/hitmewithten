# Firebase client config for CAP-13 sync, project `vocards-62df8`.
#
# These are PUBLISHABLE identifiers, not secrets: the web apiKey identifies the
# project to Google's endpoints and is visible in any client bundle. What
# protects the data is firestore.rules plus an HTTP-referrer restriction on the
# key. They live in env vars so a different project can be pointed at without a
# code change, and so a build can deliberately ship WITHOUT sync configured.
#
# Copy to .env.local (gitignored) to enable sync locally.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=vocards-62df8.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=vocards-62df8
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=vocards-62df8.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
